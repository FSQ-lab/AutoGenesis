{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.FSQ-lab/autogenesis-appium",
  "title": "AutoGenesis Appium",
  "description": "BDD automation runtime for iOS, Android, and macOS through Appium.",
  "repository": {
    "url": "https://github.com/FSQ-lab/AutoGenesis",
    "source": "github",
    "id": "1412652894",
    "subfolder": "appium-mcp-server"
  },
  "version": "0.3.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "autogenesis-appium-mcp",
      "version": "0.3.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--platform",
          "description": "Target Appium platform.",
          "choices": ["ios", "android", "mac"],
          "default": "ios"
        },
        {
          "type": "named",
          "name": "--config",
          "description": "UTF-8 Appium runtime configuration in the business project.",
          "format": "filepath",
          "isRequired": true
        },
        {
          "type": "named",
          "name": "--project-root",
          "description": "Existing business-project root that scopes generated writes.",
          "format": "filepath",
          "isRequired": true
        }
      ]
    }
  ]
}
