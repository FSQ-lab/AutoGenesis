{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FSQ-lab/AutoGenesis/schemas/secret-reference.schema.json",
  "title": "AutoGenesis Secret Reference schema 1",
  "oneOf": [
    {"$ref": "#/$defs/SecretRef"},
    {"$ref": "#/$defs/UnboundSecret"}
  ],
  "$defs": {
    "SecretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$secret"],
      "properties": {
        "$secret": {
          "type": "string",
          "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "UnboundSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$secret"],
      "properties": {
        "$secret": {
          "type": "string",
          "pattern": "^unbound:[A-Za-z0-9_.:-]+$"
        }
      }
    }
  }
}
